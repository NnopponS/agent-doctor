{
  "name": "@nnoppons/agent-doctor",
  "version": "2.0.0",
  "description": "Universal 2026 AAIF Agent Stack Inspector (AGENTS.md, SKILL.md, MCP 2026, A2A), Prompt-Cache & Token-Tax Profiler (Claude 5.5, GPT-6, Gemini 4, DeepSeek V4, Qwen 3.8), and JSON Schema Auto-Healer.",
  "type": "module",
  "bin": {
    "agent-doctor": "./dist/cli.js",
    "mcp-doctor": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "examples",
    ".well-known",
    "AGENTS.md",
    "llms.txt",
    "server.json",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "demo": "node dist/cli.js demo",
    "stack": "node dist/cli.js stack .",
    "ui": "node dist/cli.js ui"
  },
  "keywords": [
    "agent-doctor",
    "mcp-doctor",
    "model-context-protocol",
    "mcp-2026",
    "a2a",
    "agent2agent",
    "agents-md",
    "skill-md",
    "aaif",
    "prompt-caching",
    "claude-5",
    "gpt-6",
    "gemini-4",
    "deepseek-v4",
    "token-profiler",
    "json-schema",
    "linter",
    "sarif"
  ],
  "author": "Worapon Sangsasri (https://github.com/NnopponS)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NnopponS/agent-doctor.git"
  },
  "homepage": "https://nnoppons.github.io/agent-doctor/",
  "bugs": {
    "url": "https://github.com/NnopponS/agent-doctor/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
